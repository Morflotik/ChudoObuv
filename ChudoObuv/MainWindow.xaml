<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь"
        Height="800"
        Width="1200"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D2F6E7" Padding="15">
            <DockPanel>
                <Image x:Name="LogoImage"
                           Width="180"
                           Height="75"
                           Stretch="Uniform"
                           DockPanel.Dock="Left"/>

                <TextBlock Text="Каталог обуви"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel x:Name="ProductsPanel"
                        Margin="25,15,25,15"/>
        </ScrollViewer>
    </Grid>
</Window>
